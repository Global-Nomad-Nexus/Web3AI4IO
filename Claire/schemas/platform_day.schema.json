{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "web3IO Claire platform-day panel",
  "type": "object",
  "required": [
    "platform",
    "chain",
    "date_utc",
    "rule_state",
    "launches",
    "unique_creators",
    "unique_traders",
    "tokens_traded",
    "concurrent_shock"
  ],
  "properties": {
    "platform": {"type": "string", "minLength": 1},
    "chain": {"type": "string", "minLength": 1},
    "date_utc": {"type": "string", "format": "date"},
    "rule_state": {"type": "string", "minLength": 1},
    "launches": {"type": "integer", "minimum": 0},
    "unique_creators": {"type": "integer", "minimum": 0},
    "unique_traders": {"type": "integer", "minimum": 0},
    "tokens_traded": {"type": "integer", "minimum": 0},
    "concurrent_shock": {"type": "boolean"}
  },
  "additionalProperties": true
}
